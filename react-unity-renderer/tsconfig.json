{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist",
    "sourceMap": true,
    "allowJs": true,
    "pretty": true,
    "declaration": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "preserveSymlinks": true,
    "importHelpers": false,
    "strict": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "target": "ES5",
    "skipLibCheck": true,
    "lib": ["ES2019"],
    "preserveConstEnums": true,
    "esModuleInterop": false,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "types": []
  },
  "files": [
    "index.ts",
    "tests.ts",
    "ugui/index.ts",
    "ugui/jsx-dev-runtime.ts",
    "ugui/jsx-runtime.ts",
    "uitoolkit/index.ts",
    "uitoolkit/jsx-dev-runtime.ts",
    "uitoolkit/jsx-runtime.ts",
    "editor/index.ts",
    "editor/jsx-dev-runtime.ts",
    "editor/jsx-runtime.ts",
    "webgl-compat.ts"
  ]
}
